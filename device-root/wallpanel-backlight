#!/system/bin/sh

PIDFILE=/data/local/tmp/wallpanel-backlight.pid
LOGFILE=/data/local/tmp/wallpanel-backlight.log
TOOL=/system/xbin/sunxi-displayctl
SETTINGS_DB=/data/data/com.android.providers.settings/databases/settings.db
MAX_LEVEL=191
SCRIPT_PATH=/system/xbin/wallpanel-backlight
MODE_FILE=/data/local/wallpanel-display-mode
BACKLIGHT_GATE=/sys/bus/i2c/devices/0-0034/axp20-gpio.29
# Preserve the existing LCD-off profile unless explicitly selected otherwise.
DISPLAY_MODE=$(cat "$MODE_FILE" 2>/dev/null)
case "$DISPLAY_MODE" in
    backlight-only) ;;
    *) DISPLAY_MODE=lcd-off ;;
esac

if [ -f "$PIDFILE" ]; then
    OLD_PID=$(cat "$PIDFILE" 2>/dev/null)
    if [ -n "$OLD_PID" ] && kill -0 "$OLD_PID" 2>/dev/null && \
            busybox grep -q "$SCRIPT_PATH" "/proc/$OLD_PID/cmdline" 2>/dev/null; then
        exit 0
    fi
    busybox rm -f "$PIDFILE"
fi

echo $$ > "$PIDFILE"
trap 'busybox rm -f "$PIDFILE"' EXIT
trap 'exit 0' INT TERM

read_android_brightness() {
    sqlite3 "$SETTINGS_DB" \
        "select value from system where name='screen_brightness';" 2>/dev/null
}

# On this Denver, script.fex assigns lcd_bl_en to AXP20 GPIO1 (power1).
# GPIO0 is LCD power and must never be changed. Use the existing GPIO driver,
# preserve its selector, and refuse to reconfigure an unexpected input pin.
set_backlight_gate() {
    PREVIOUS_GPIO=$(cat "$BACKLIGHT_GATE/gpio" 2>/dev/null) || return 1
    echo 1 > "$BACKLIGHT_GATE/gpio" || return 1
    GATE_IO=$(cat "$BACKLIGHT_GATE/io" 2>/dev/null)
    if [ "$GATE_IO" != 1 ]; then
        echo "$PREVIOUS_GPIO" > "$BACKLIGHT_GATE/gpio"
        return 1
    fi
    echo "$1" > "$BACKLIGHT_GATE/value"
    GATE_RESULT=$?
    echo "$PREVIOUS_GPIO" > "$BACKLIGHT_GATE/gpio"
    return "$GATE_RESULT"
}

# Transition out of the old LCD-off profile once. In backlight-only mode,
# subsequent transitions must never reinitialize or repeatedly poke the LCD.
if [ "$DISPLAY_MODE" = backlight-only ]; then
    if [ ! -w "$BACKLIGHT_GATE/value" ]; then
        echo "$(date) backlight-only: required AXP20 GPIO interface missing" >> "$LOGFILE"
        exit 1
    fi
    "$TOOL" on
elif [ -f "$MODE_FILE" ] && [ -w "$BACKLIGHT_GATE/value" ]; then
    # Reverting an explicitly configured device must reopen the backlight gate.
    set_backlight_gate 1
fi

LAST_LEVEL=-1
OFF_REASSERT_COUNT=0
while true; do
    LEVEL=$(read_android_brightness)

    if [ -n "$LEVEL" ]; then
        if [ "$LEVEL" -le 5 ]; then
            # Both profiles keep Android and the camera awake. The optional
            # mains-powered profile leaves the LCD image active and sets only
            # its backlight to zero. Reassert only the legacy LCD-off profile:
            # avoid redundant brightness writes in the backlight-only profile.
            if [ "$LEVEL" != "$LAST_LEVEL" ] || \
                    { [ "$DISPLAY_MODE" = lcd-off ] && [ "$OFF_REASSERT_COUNT" -ge 5 ]; }; then
                if [ "$DISPLAY_MODE" = backlight-only ]; then
                    set_backlight_gate 0 || {
                        echo "$(date) backlight-only: unable to close light gate" >> "$LOGFILE"
                        exit 1
                    }
                    "$TOOL" 0
                else
                    "$TOOL" off
                fi
                OFF_REASSERT_COUNT=0
                if [ "$LEVEL" != "$LAST_LEVEL" ]; then
                    echo "$(date) android=$LEVEL mode=$DISPLAY_MODE dark=1 camera=active" >> "$LOGFILE"
                fi
            fi
            OFF_REASSERT_COUNT=$((OFF_REASSERT_COUNT + 1))
        else
            OFF_REASSERT_COUNT=0
            if [ "$LEVEL" != "$LAST_LEVEL" ]; then
                HARDWARE_LEVEL=$LEVEL
                if [ "$HARDWARE_LEVEL" -gt "$MAX_LEVEL" ]; then
                    HARDWARE_LEVEL=$MAX_LEVEL
                fi
                if [ "$DISPLAY_MODE" = lcd-off ]; then "$TOOL" on; fi
                "$TOOL" "$HARDWARE_LEVEL"
                if [ "$DISPLAY_MODE" = backlight-only ]; then
                    set_backlight_gate 1 || {
                        echo "$(date) backlight-only: unable to open light gate" >> "$LOGFILE"
                        exit 1
                    }
                fi
                echo "$(date) android=$LEVEL lcd=on hardware=$HARDWARE_LEVEL" >> "$LOGFILE"
            fi
        fi
        LAST_LEVEL=$LEVEL
    fi

    sleep 1
done
