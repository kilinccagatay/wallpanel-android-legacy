#!/system/bin/sh

PIDFILE=/data/local/tmp/wallpanel-watchdog.pid
LOGFILE=/data/local/tmp/wallpanel-watchdog.log
PACKAGE=com.thanksmister.iot.wallpanellegacy
# Start the browser directly. Bringing WelcomeActivity's existing task forward
# can leave SettingsActivity on top, which destroys the camera preview and
# makes motion wake impossible until the browser is opened again.
ACTIVITY=$PACKAGE/.ui.activities.BrowserActivityLegacy
SETTINGS_DB=/data/data/com.android.providers.settings/databases/settings.db
MAX_RSS_KB=180000
MIN_DARK_SECONDS=300
SCRIPT_PATH=/system/xbin/wallpanel-watchdog

if [ -f "$PIDFILE" ]; then
    OLD_PID=$(cat "$PIDFILE" 2>/dev/null)
    if [ -n "$OLD_PID" ] && kill -0 "$OLD_PID" 2>/dev/null && \
            busybox grep -q "$SCRIPT_PATH" "/proc/$OLD_PID/cmdline" 2>/dev/null; then
        exit 0
    fi
    busybox rm -f "$PIDFILE"
fi

echo $$ > "$PIDFILE"
trap 'busybox rm -f "$PIDFILE"' EXIT
trap 'exit 0' INT TERM

log_message() {
    echo "$(date) $1" >> "$LOGFILE"
    LOG_SIZE=$(busybox wc -c < "$LOGFILE" 2>/dev/null)
    if [ -n "$LOG_SIZE" ] && [ "$LOG_SIZE" -gt 65536 ]; then
        busybox tail -100 "$LOGFILE" > "$LOGFILE.tmp"
        busybox mv -f "$LOGFILE.tmp" "$LOGFILE"
    fi
}

read_android_brightness() {
    sqlite3 "$SETTINGS_DB" \
        "select value from system where name='screen_brightness';" 2>/dev/null
}

uptime_seconds() {
    busybox awk '{print int($1)}' /proc/uptime 2>/dev/null
}

start_dashboard() {
    # This Android 4.1 ROM can expose its swipe keyguard even though WallPanel
    # disables it. MENU dismisses that insecure keyguard before the browser is
    # brought forward.
    if dumpsys window 2>/dev/null | busybox grep -q 'mCurrentFocus=.*Keyguard'; then
        input keyevent 82 >/dev/null 2>&1
        sleep 2
    fi
    am start -n "$ACTIVITY" >/dev/null 2>&1
    log_message "$1"
    sleep 12
}

DARK_SINCE=0
while true; do
    APP_PID=$(busybox pidof "$PACKAGE" 2>/dev/null)
    BRIGHTNESS=$(read_android_brightness)
    NOW=$(uptime_seconds)

    if [ -n "$BRIGHTNESS" ] && [ "$BRIGHTNESS" -le 5 ]; then
        if [ "$DARK_SINCE" -eq 0 ]; then
            DARK_SINCE=$NOW
        fi
    else
        DARK_SINCE=0
    fi

    if [ -z "$APP_PID" ]; then
        start_dashboard "app_missing: dashboard_started"
    else
        FOCUS=$(dumpsys window 2>/dev/null | busybox grep 'mCurrentFocus=' | busybox head -1)

        # The process can remain alive while SettingsActivity or the keyguard
        # is on top. SettingsActivity has no camera preview; the legacy camera
        # service then closes and motion can no longer wake the display. Keep
        # the dedicated tablet on BrowserActivityLegacy, regardless of which
        # non-dashboard window displaced it.
        if ! echo "$FOCUS" | busybox grep -q \
                "$PACKAGE/$PACKAGE.ui.activities.BrowserActivityLegacy"; then
            start_dashboard "dashboard_not_focused: focus=$FOCUS dashboard_started"
        else
            RSS_KB=$(busybox awk '/VmRSS:/ {print $2}' "/proc/$APP_PID/status" 2>/dev/null)
            DARK_SECONDS=0
            if [ "$DARK_SINCE" -gt 0 ]; then
                DARK_SECONDS=$((NOW - DARK_SINCE))
            fi

            # Crosswalk grows over time on this 362 MB tablet. Perform memory
            # maintenance only after five continuous dark minutes, rather than
            # immediately before a likely motion wake.
            if [ -n "$RSS_KB" ] && [ "$RSS_KB" -gt "$MAX_RSS_KB" ] && \
               [ "$DARK_SECONDS" -ge "$MIN_DARK_SECONDS" ]; then
                log_message "high_memory_idle: rss_kb=$RSS_KB dark_seconds=$DARK_SECONDS restarting"
                am force-stop "$PACKAGE" >/dev/null 2>&1
                sleep 2
                start_dashboard "high_memory_idle: dashboard_restarted"

                # The backlight helper continuously restores hardware LCD_OFF
                # while brightness remains zero. Do not send a power key here:
                # real Android screen-off stalls this tablet's V4L2 camera.
                DARK_SINCE=$(uptime_seconds)
            fi
        fi
    fi

    sleep 30
done
